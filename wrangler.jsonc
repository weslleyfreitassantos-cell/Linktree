{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "linktree",
	"main": "worker.js",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"assets": {
    "directory": "./deploy-clean"
	},
	"kv_namespaces": [
		{
			"binding": "LINKTREE_DATA",
